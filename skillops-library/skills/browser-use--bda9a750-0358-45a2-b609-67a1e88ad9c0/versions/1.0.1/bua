def _resolve_agent_browser_bin() -> Optional[str]:
    """AGENT_BROWSER_BIN if set, else a binary beside this script. No PATH."""
    override = os.environ.get("AGENT_BROWSER_BIN")
    if override:
        return override
    try:
        here = os.path.dirname(os.path.abspath(__file__))
    except NameError:
        here = os.getcwd()
    for rel in (("agent-browser",), ("bin", "agent-browser")):
        p = os.path.join(here, *rel)
        if os.path.isfile(p):
            return p
    return None


