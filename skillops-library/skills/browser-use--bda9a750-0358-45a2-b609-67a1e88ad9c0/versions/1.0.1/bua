def _ensure_state_dir() -> None:
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
    except PermissionError:
        globals()["STATE_DIR"] = os.path.expanduser("~/.arkclaw/bua-state")
        globals()["STATE_FILE"] = os.path.join(STATE_DIR, "sessions.json")
        globals()["LOCK_FILE"] = os.path.join(STATE_DIR, "bua.lock")
        globals()["CHROME_PID_FILE"] = os.path.join(STATE_DIR, "chrome.pid")
        os.makedirs(STATE_DIR, exist_ok=True)


class _Lock:
    def __init__(self, path: str) -> None:
        self.path = path
        self.fd: Optional[int] = None

    def __enter__(self) -> "_Lock":
        _ensure_state_dir()
        self.fd = os.open(self.path, os.O_CREAT | os.O_RDWR, 0o644)
        fcntl.flock(self.fd, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc: Any) -> None:
        if self.fd is not None:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_UN)
            finally:
                os.close(self.fd)
                self.fd = None


def load_state() -> Dict[str, Any]:
    _ensure_state_dir()
    if not os.path.exists(STATE_FILE):
        return {"sessions": {}}
    try:
        with open(STATE_FILE, "r", encoding="utf-8") as f:
            state = json.load(f)
    except (OSError, json.JSONDecodeError):
        return {"sessions": {}}
    # Forward migration:
    #  - legacy `targetId` -> `activeTargetId`
    #  - missing `tabsOrder` -> seed with [activeTargetId] if any, else []
    sessions = state.get("sessions") or {}
    if isinstance(sessions, dict):
        for s in sessions.values():
            if not isinstance(s, dict):
                continue
            legacy = s.pop("targetId", None)
            if legacy and not s.get("activeTargetId"):
                s["activeTargetId"] = legacy
            if "tabsOrder" not in s or not isinstance(s.get("tabsOrder"), list):
                active = s.get("activeTargetId")
                s["tabsOrder"] = [active] if active else []
    # v1.14.0: Chrome instance fingerprint (None = unknown / pre-v1.14.0 state).
    state.setdefault(CHROME_FP_FIELD, None)
    return state


def save_state(state: Dict[str, Any]) -> None:
    _ensure_state_dir()
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, STATE_FILE)


# --------------------------------------------------------------------------- #
# Chrome lifecycle                                                            #
# --------------------------------------------------------------------------- #

def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError as e:
        return e.errno == errno.EPERM



def _chrome_fingerprint(cdp: CDP) -> Optional[str]:
    """
    Stable-within-one-Chrome-lifetime, distinct-across-restarts identifier.

    Reads /json/version over HTTP (single RTT, cheap — same endpoint used by
    CDP.connect for handshake). Extracts the UUID from webSocketDebuggerUrl
    so the fingerprint is short and greppable in logs. Includes `product` so
    a Chrome binary upgrade also counts as a new instance.

    Returns None on failure — caller treats as "unknown, assume changed".
    """
    try:
        ver = cdp._http_json("/json/version")
    except Exception as e:
        _log(logging.WARNING, "-", "fingerprint", f"getVersion failed: {e!r}")
        return None
    ws = ver.get("webSocketDebuggerUrl") or ""
    product = ver.get("Browser") or ver.get("product") or ""
    m = re.search(r"/devtools/browser/([0-9a-fA-F-]{36})", ws)
    uuid = m.group(1) if m else ws
    return f"{product}|{uuid}"


def _invalidate_all_sessions(state: Dict[str, Any], reason: str) -> List[str]:
    """
    Drop all sessions from state. Caller holds the lock and must save_state().
    Returns the list of sids that were dropped (for logging / telemetry).

    We do NOT attempt to close CDP targets — by definition the recorded
    windowIds are dead (stale integers from a previous Chrome process).
    """
    sessions = state.get("sessions") or {}
    if not sessions:
        return []
    dropped = list(sessions.keys())
    state["sessions"] = {}
    _log(logging.WARNING, "-", "reconcile",
         f"invalidated {len(dropped)} sessions ({reason}): {dropped}")
    return dropped


def ensure_chrome() -> CDP:
    """
    Guarantee a Chrome instance with CDP alive on (CDP_HOST, CDP_PORT), and
    reconcile state with it:

    * fast path  : CDP already alive → verify fingerprint matches state.
                   If state's fp differs from runtime fp, Chrome was restarted
                   behind our back — invalidate all sessions (their windowIds
                   are stale integers from the dead process).
    * slow path  : spawn Chrome, wait up to 15s, then invalidate all sessions
                   unconditionally (we know we just replaced the instance).

    Returns a CDP client bound to the current instance.
    """
    cdp = CDP()
    spawned = False

    if not cdp.ping():
        _ensure_state_dir()
        os.makedirs(PROFILE_DIR, exist_ok=True)

        if os.path.exists(CHROME_PID_FILE):
            try:
                pid = int(open(CHROME_PID_FILE).read().strip() or "0")
                if pid and not _pid_alive(pid):
                    os.unlink(CHROME_PID_FILE)
            except (OSError, ValueError):
                pass

        argv = [
            CHROME_BIN,
            f"--user-data-dir={PROFILE_DIR}",
            f"--remote-debugging-port={CDP_PORT}",
            f"--remote-debugging-address={CDP_HOST}",
            *DEFAULT_CHROME_ARGS,
            "about:blank",
        ]
        env = {**os.environ}
        env.setdefault("DISPLAY", DISPLAY)
        _log(logging.INFO, "-", "ensure_chrome", f"spawn argv={argv}")

        log_fd = os.open(CHROME_LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        proc = subprocess.Popen(
            argv,
            stdout=log_fd,
            stderr=log_fd,
            stdin=subprocess.DEVNULL,
            env=env,
            start_new_session=True,
            close_fds=True,
        )
        os.close(log_fd)
        try:
            with open(CHROME_PID_FILE, "w") as f:
                f.write(str(proc.pid))
        except OSError:
            pass

        deadline = time.time() + 15.0
        while time.time() < deadline:
            if cdp.ping():
                spawned = True
                _log(logging.INFO, "-", "ensure_chrome",
                     f"chrome up pid={proc.pid} cdp={CDP_PORT}")
                break
            time.sleep(0.25)
        else:
            raise RuntimeError(
                f"chrome failed to expose CDP on {CDP_HOST}:{CDP_PORT}"
            )

    # ---- Reconcile state with the Chrome instance we're about to use ----
    # Runs on both fast and slow paths. Handles:
    #   a. first run ever                 → adopt current fp, no invalidate
    #   b. upgrade from pre-v1.14.0 state → adopt current fp, no invalidate
    #      (existing windowIds stay valid if Chrome kept running across upgrade;
    #       any stale ones get cleaned by L1 sweep on next op)
    #   c. Chrome respawned behind our back → invalidate all sessions
    #   d. we just spawned Chrome ourselves → invalidate all sessions
    new_fp = _chrome_fingerprint(cdp)
    with _Lock(LOCK_FILE):
        state = load_state()
        old_fp = state.get(CHROME_FP_FIELD)

        if new_fp is None:
            # Couldn't fingerprint. Be conservative:
            #   - if we just spawned, we know Chrome is new → invalidate
            #   - otherwise leave state alone (likely transient CDP hiccup)
            if spawned:
                _invalidate_all_sessions(state, reason="spawned,no-fp")
                state[CHROME_FP_FIELD] = None
                save_state(state)
        elif spawned:
            # We replaced the Chrome process; old windowIds are dead.
            _invalidate_all_sessions(
                state, reason=f"spawned fp={new_fp[:16]}"
            )
            state[CHROME_FP_FIELD] = new_fp
            save_state(state)
        elif old_fp is None:
            # First run OR upgrade from pre-v1.14.0 state. Adopt without
            # invalidating — any stale windowIds will be cleaned by L1 sweep.
            state[CHROME_FP_FIELD] = new_fp
            save_state(state)
            _log(logging.INFO, "-", "reconcile",
                 f"adopted fp={new_fp[:16]} (first run or migration)")
        elif old_fp != new_fp:
            # Chrome was restarted by someone else (systemd, OOM + external
            # supervisor, manual). All recorded windowIds are stale.
            _invalidate_all_sessions(
                state,
                reason=f"respawn old={old_fp[:16]} new={new_fp[:16]}",
            )
            state[CHROME_FP_FIELD] = new_fp
            save_state(state)
        # else: fp match, nothing to do.

    return cdp


# --------------------------------------------------------------------------- #
# Core ops                                                                    #
# --------------------------------------------------------------------------- #

def _get_page_targets(cdp: CDP) -> Dict[str, Dict[str, Any]]:
    res = cdp.call("Target.getTargets")
    return {
        t["targetId"]: t
        for t in res.get("targetInfos", [])
        if t.get("type") == "page"
    }


def _targets_in_window(cdp: CDP, wid: Any) -> List[Dict[str, Any]]:
    """Return page targets that belong to Browser window `wid`, preserving
    the order returned by CDP (which is typically creation-ascending).
    """
    if wid is None:
        return []
    out: List[Dict[str, Any]] = []
    for t in _get_page_targets(cdp).values():
        try:
            w = cdp.call("Browser.getWindowForTarget",
                         {"targetId": t["targetId"]})["windowId"]
        except RuntimeError:
            continue
        if w == wid:
            out.append(t)
    return out


def _pick_fallback_target(targets: List[Dict[str, Any]]) -> str:
    """Given a non-empty list of page targets (in CDP order), pick the best
    fallback: prefer the newest non-blank target; else the newest of any.
    """
    assert targets, "targets must be non-empty"
    non_blank = [t for t in targets if not _is_blank_url(t.get("url") or "")]
    return (non_blank or targets)[-1]["targetId"]


def _resolve_active_target(cdp: CDP, sess: Dict[str, Any]
                           ) -> Tuple[str, str]:
    """Return (target_id, resolved_from) for `sess`. Mutates sess in place
    by rewriting `activeTargetId` on fallback — callers are responsible for
    persisting via `save_state` if they want the change to stick.

    resolved_from:
      "state"    -> the persisted activeTargetId is still live
      "fallback" -> activeTargetId was missing/stale; a new tab was picked
    Raises RuntimeError if the window has no live page tabs.
    """
    wid = sess.get("windowId")
    targets = _targets_in_window(cdp, wid)
    if not targets:
        raise RuntimeError(f"session has no live tab (windowId={wid})")

    current = sess.get("activeTargetId")
    if current:
        for t in targets:
            if t["targetId"] == current:
                return current, "state"

    chosen = _pick_fallback_target(targets)
    sess["activeTargetId"] = chosen
    return chosen, "fallback"


def _sync_tabs_order(sess: Dict[str, Any],
                     live_targets: List[Dict[str, Any]]) -> None:
    """Reconcile sess['tabsOrder'] against the live targets in its window:
      - drop tids no longer live (tab closed / crashed)
      - append live tids not yet recorded (e.g. spawned by window.open or
        from an older bua version that did not track tabsOrder)
    Preserves existing ordering for still-alive tabs so T<N> references are
    stable across commands.
    """
    live_ids = [t["targetId"] for t in live_targets]
    live_set = set(live_ids)
    existing = [tid for tid in (sess.get("tabsOrder") or []) if tid in live_set]
    existing_set = set(existing)
    for tid in live_ids:
        if tid not in existing_set:
            existing.append(tid)
            existing_set.add(tid)
    sess["tabsOrder"] = existing


def _resolve_tab_ref(sess: Dict[str, Any], ref: str) -> str:
    """Translate a user-supplied tab reference to a targetId.
    Accepts:
      - 'T<N>' / 't<N>' (1-based index into sess['tabsOrder'])
      - raw 32-hex targetId (escape hatch for scripting)
    Does not verify that the target is still live in CDP; callers should
    cross-check against the current window's live targets.
    """
    if not ref:
        raise ValueError("empty tab reference")
    m = _TAB_REF_RE.match(ref)
    if m:
        order = sess.get("tabsOrder") or []
        idx = int(m.group(1)) - 1
        if idx < 0 or idx >= len(order):
            raise ValueError(
                f"tab ref {ref} out of range (session has {len(order)} tabs)"
            )
        return order[idx]
    if _HEX_TID_RE.match(ref):
        return ref
    raise ValueError(
        f"invalid tab reference: {ref!r} (use T<N> or raw targetId)"
    )


def _window_alive(cdp: CDP, wid: Any) -> bool:
    if wid is None:
        return False
    return bool(_targets_in_window(cdp, wid))


def _validate_session(cdp: CDP, sess: Dict[str, Any]) -> bool:
    """A session is live iff its windowId still has at least one page tab."""
    return _window_alive(cdp, sess.get("windowId"))


def _windows_with_pages(cdp: CDP) -> set:
    """Set of Browser windowIds that currently have at least one page target."""
    wids: set = set()
    for t in _get_page_targets(cdp).values():
        try:
            w = cdp.call("Browser.getWindowForTarget",
                         {"targetId": t["targetId"]})["windowId"]
            wids.add(w)
        except RuntimeError:
            continue
    return wids


def _close_window_tabs(cdp: CDP, wid: Any) -> None:
    """Close every page target belonging to Browser window wid."""
    if wid is None:
        return
    targets = _get_page_targets(cdp)
    for tid in list(targets.keys()):
        try:
            w = cdp.call("Browser.getWindowForTarget",
                         {"targetId": tid})["windowId"]
        except RuntimeError:
            continue
        if w == wid:
            try:
                cdp.call("Target.closeTarget", {"targetId": tid})
            except RuntimeError:
                pass


def _touch(sess: Dict[str, Any]) -> None:
    """Update lastUsedAt timestamp on a session record."""
    sess["lastUsedAt"] = int(time.time())


def _sweep_dead(cdp: "CDP", state: Dict[str, Any]) -> list:
    """Remove sessions whose Browser window has no page targets left."""
    wids_live = _windows_with_pages(cdp)
    dead: list = []
    for sid, s in list(state["sessions"].items()):
        wid = s.get("windowId")
        if wid is not None and wid in wids_live:
            continue
        dead.append(sid)
        state["sessions"].pop(sid, None)
    return dead


_DURATION_UNITS = {"s": 1, "m": 60, "h": 3600, "d": 86400}


def _parse_duration(s: str) -> int:
    s = str(s).strip().lower()
    if not s:
        raise ValueError("empty duration")
    if s[-1] in _DURATION_UNITS:
        return int(s[:-1]) * _DURATION_UNITS[s[-1]]
    return int(s)


def op_open(sid: str, url: str, replace_tab: bool = False) -> int:
    cdp = ensure_chrome()
    with _Lock(LOCK_FILE):
        state = load_state()
        _sweep_dead(cdp, state)
        sess = state["sessions"].get(sid)

        # A. sid alive -> default: new tab in the same window.
        #    --replace-tab: navigate the currently-active tab instead.
        if sess and _validate_session(cdp, sess):
            wid = sess["windowId"]
            if replace_tab:
                # Resolve the persisted active tab (or fallback). Navigate it
                # without creating a new target; activeTargetId stays the same
                # conceptual slot.
                try:
                    tid, resolved_from = _resolve_active_target(cdp, sess)
                except RuntimeError:
                    tid, resolved_from = None, "none"
                if tid:
                    session_id = _attach(cdp, tid)
                    cdp.call("Page.navigate", {"url": url},
                             session_id=session_id)
                    try:
                        cdp.call("Target.activateTarget", {"targetId": tid})
                    except RuntimeError:
                        pass
                    if resolved_from == "fallback":
                        _log(logging.WARNING, sid, "open",
                             f"active tab fallback -> {tid}")
                _sync_tabs_order(sess, _targets_in_window(cdp, wid))
                sess["url"] = url
                _touch(sess)
                save_state(state)
                _apply_window_state(cdp, wid)
                return _ok(sid, sess, url, target_id=tid)
     
            anchor_targets = _targets_in_window(cdp, wid)
            anchor_tid: Optional[str] = None
            if anchor_targets:
                candidate = sess.get("activeTargetId")
                live_ids = {t["targetId"] for t in anchor_targets}
                anchor_tid = candidate if candidate in live_ids \
                    else _pick_fallback_target(anchor_targets)
                try:
                    cdp.call("Target.activateTarget",
                             {"targetId": anchor_tid})
                except RuntimeError:
                    pass

            res = cdp.call("Target.createTarget",
                           {"url": url, "newWindow": False})
            tid = res["targetId"]
            try:
                new_wid = cdp.call("Browser.getWindowForTarget",
                                   {"targetId": tid})["windowId"]
            except RuntimeError:
                new_wid = wid

            if new_wid != wid:
                # Tab landed in the wrong window - close it and retry via
                # window.open from an anchor tab inside the correct window.
                _log(logging.WARNING, sid, "open",
                     f"stray tab {tid} landed in wid={new_wid}, "
                     f"expected wid={wid}; falling back to window.open")
                try:
                    cdp.call("Target.closeTarget", {"targetId": tid})
                except RuntimeError:
                    pass
                if not anchor_tid:
                    raise RuntimeError(
                        f"session {sid}: cannot open in window {wid} "
                        f"(no anchor tab available)"
                    )
                before = set(_get_page_targets(cdp).keys())
                anchor_sess_id = _attach(cdp, anchor_tid)
                cdp.call(
                    "Runtime.evaluate",
                    {"expression":
                        f"window.open({json.dumps(url)}, '_blank')",
                     "awaitPromise": False},
                    session_id=anchor_sess_id,
                )
                tid = None
                deadline = time.time() + 3.0
                while time.time() < deadline:
                    current = _get_page_targets(cdp)
                    for nid in current.keys() - before:
                        try:
                            w = cdp.call("Browser.getWindowForTarget",
                                         {"targetId": nid})["windowId"]
                        except RuntimeError:
                            continue
                        if w == wid:
                            tid = nid
                            break
                    if tid:
                        break
                    time.sleep(0.05)
                if not tid:
                    raise RuntimeError(
                        f"session {sid}: failed to create tab in "
                        f"window {wid} via window.open fallback"
                    )

            try:
                cdp.call("Target.activateTarget", {"targetId": tid})
            except RuntimeError:
                pass
            sess["activeTargetId"] = tid
            # Refresh tabsOrder against live window; ensure new tid is at end.
            live = _targets_in_window(cdp, wid)
            _sync_tabs_order(sess, live)
            if tid in sess["tabsOrder"]:
                sess["tabsOrder"] = [x for x in sess["tabsOrder"] if x != tid]
            sess["tabsOrder"].append(tid)
            sess["url"] = url
            _touch(sess)
            save_state(state)
            _apply_window_state(cdp, wid)
            return _ok(sid, sess, url, target_id=tid)

        # B. sid not alive -> adopt a reusable blank window before spawning.
        reuse = _pick_reusable_blank(cdp, state)
        if reuse:
            tid = reuse["targetId"]
            session_id = _attach(cdp, tid)
            cdp.call("Page.navigate", {"url": url}, session_id=session_id)
            wid = reuse.get("windowId") or cdp.call(
                "Browser.getWindowForTarget",
                {"targetId": tid})["windowId"]
        else:
            res = cdp.call("Target.createTarget",
                           {"url": url, "newWindow": True})
            tid = res["targetId"]
            wid = cdp.call("Browser.getWindowForTarget",
                           {"targetId": tid})["windowId"]

        try:
            cdp.call("Target.activateTarget", {"targetId": tid})
        except RuntimeError:
            pass
        _apply_window_state(cdp, wid)

        sess = {
            "sid": sid,
            "windowId": wid,
            "activeTargetId": tid,
            "tabsOrder": [tid],
            "alive": True,
            "url": url,
            "title": "",
            "createdAt": int(time.time()),
            "lastUsedAt": int(time.time()),
        }
        state["sessions"][sid] = sess
        save_state(state)
        return _ok(sid, sess, url, target_id=tid)


def op_focus(sid: str) -> int:
    cdp = ensure_chrome()
    tid: Optional[str] = None
    wid: Any = None
    with _Lock(LOCK_FILE):
        state = load_state()
        sess = state["sessions"].get(sid)
        if not sess or not _validate_session(cdp, sess):
            _log(logging.ERROR, sid, "focus", "no live window")
            print(f"bua: no window for session {sid}", file=sys.stderr)
            return 1
        try:
            tid, resolved_from = _resolve_active_target(cdp, sess)
        except RuntimeError as e:
            _log(logging.ERROR, sid, "focus", f"resolve failed: {e}")
            print(f"bua: focus failed: {e}", file=sys.stderr)
            return 1
        if resolved_from == "fallback":
            _log(logging.WARNING, sid, "focus",
                 f"active tab fallback -> {tid}")
        wid = sess["windowId"]
        _touch(sess)
        save_state(state)
    try:
        cdp.call("Target.activateTarget", {"targetId": tid})
    except RuntimeError as e:
        _log(logging.ERROR, sid, "focus", f"CDP failed: {e}")
        print(f"bua: focus failed: {e}", file=sys.stderr)
        return 1
    _apply_window_state(cdp, wid)
    _log(logging.INFO, sid, "focus", f"window={wid} tab={tid}")
    return 0


def op_close(sid: str) -> int:
    cdp = ensure_chrome()
    with _Lock(LOCK_FILE):
        state = load_state()
        sess = state["sessions"].pop(sid, None)
        save_state(state)
        # Close tabs inside the lock to avoid racing a concurrent `open` that
        # could re-bind the same sid to a freshly-created window.
        if sess:
            try:
                _close_window_tabs(cdp, sess.get("windowId"))
            except RuntimeError as e:
                _log(logging.WARNING, sid, "close", f"{e}")
    if not sess:
        print(f"bua: session {sid} not found", file=sys.stderr)
        return 1
    _log(logging.INFO, sid, "close", f"window={sess.get('windowId')}")
    print(json.dumps({"ok": True, "sid": sid}))
    return 0


def op_status(sid: Optional[str]) -> int:
    up = CDP().ping()
    state = load_state()
    if sid:
        sess = state["sessions"].get(sid)
        print(json.dumps({"version": VERSION, "chromeUp": up,
                          "sid": sid, "session": sess}, indent=2))
    else:
        print(json.dumps({"version": VERSION, "chromeUp": up,
                          "port": CDP_PORT, "profile": PROFILE_DIR,
                          "sessionCount": len(state["sessions"])}, indent=2))
    return 0


def op_list() -> int:
    cdp = ensure_chrome()
    with _Lock(LOCK_FILE):
        state = load_state()
        _sweep_dead(cdp, state)
        save_state(state)
    targets = _get_page_targets(cdp)
    wids_live = _windows_with_pages(cdp)
    rows = []
    for sid, sess in state["sessions"].items():
        wid = sess.get("windowId")
        win_alive = wid is not None and wid in wids_live
        active_tid = sess.get("activeTargetId")
        # Is the persisted activeTargetId still in the window? If not, show
        # what a fallback *would* pick, but do not mutate state from `list`.
        resolved_from = "state"
        resolved_tid = active_tid
        if win_alive:
            tabs = _targets_in_window(cdp, wid)
            tab_ids = {t["targetId"] for t in tabs}
            if not active_tid or active_tid not in tab_ids:
                resolved_tid = _pick_fallback_target(tabs) if tabs else None
                resolved_from = "fallback" if resolved_tid else "none"
        else:
            tabs = []
            resolved_tid = None
            resolved_from = "none"
        t = targets.get(resolved_tid, {}) if resolved_tid else {}
        rows.append({
            "sid": sid,
            "windowId": wid,
            "activeTargetId": active_tid,
            "resolvedTargetId": resolved_tid,
            "resolvedFrom": resolved_from,
            "tabCount": len(tabs),
            "tabsOrder": sess.get("tabsOrder") or [],
            "alive": win_alive,
            "url": t.get("url") or sess.get("url"),
            "title": t.get("title"),
        })
    print(json.dumps({"sessions": rows}, indent=2))
    return 0


# --------------------------------------------------------------------------- #
# Tabs command family                                                          #
#                                                                              #
# All `bua tabs <sub>` operations are NATIVE (never forwarded to               #
# agent-browser) because:                                                      #
#   1. agent-browser's tab subcommands operate on its own `pages[]`, which     #
#      spans every target it has attached — crossing sid boundaries.           #
#   2. bua must keep `sess.activeTargetId` and `sess.tabsOrder` in sync with   #
#      any tab creation/deletion.                                              #
#   3. Per-session T<N> references avoid collisions between sessions.          #
# --------------------------------------------------------------------------- #

def op_tabs_list(sid: str) -> int:
    cdp = ensure_chrome()
    with _Lock(LOCK_FILE):
        state = load_state()
        sess = state["sessions"].get(sid)
        if not sess or not _validate_session(cdp, sess):
            print(f"bua: no window for session {sid}", file=sys.stderr)
            return 1
        live = _targets_in_window(cdp, sess["windowId"])
        _sync_tabs_order(sess, live)
        _touch(sess)
        save_state(state)
        order_snapshot = list(sess["tabsOrder"])
        wid_snapshot = sess.get("windowId")
        active_snapshot = sess.get("activeTargetId")
    tab_map = {t["targetId"]: t for t in live}
    rows = []
    for i, tid in enumerate(order_snapshot, start=1):
        t = tab_map.get(tid, {})
        rows.append({
            "ref": f"T{i}",
            "targetId": tid,
            "active": tid == active_snapshot,
            "url": t.get("url"),
            "title": t.get("title"),
        })
    print(json.dumps({
        "sid": sid,
        "windowId": wid_snapshot,
        "activeTargetId": active_snapshot,
        "tabs": rows,
    }, indent=2))
    return 0


def op_tabs_new(sid: str, url: str) -> int:
    cdp = ensure_chrome()
    sess_snapshot: Optional[Dict[str, Any]] = None
    tid: Optional[str] = None
    with _Lock(LOCK_FILE):
        state = load_state()
        sess = state["sessions"].get(sid)
        if not sess or not _validate_session(cdp, sess):
            print(f"bua: no window for session {sid}", file=sys.stderr)
            return 1
        wid = sess["windowId"]
        res = cdp.call("Target.createTarget",
                       {"url": url, "newWindow": False})
        tid = res["targetId"]
        try:
            actual_wid = cdp.call("Browser.getWindowForTarget",
                                  {"targetId": tid})["windowId"]
        except RuntimeError:
            actual_wid = wid
        if actual_wid != wid:
            # Chrome placed the tab in another window; re-bind the session.
            sess["windowId"] = actual_wid
        live = _targets_in_window(cdp, sess["windowId"])
        _sync_tabs_order(sess, live)
        if tid in sess["tabsOrder"]:
            sess["tabsOrder"] = [x for x in sess["tabsOrder"] if x != tid]
        sess["tabsOrder"].append(tid)
        sess["activeTargetId"] = tid
        sess["url"] = url
        _touch(sess)
        save_state(state)
        sess_snapshot = dict(sess)
    try:
        cdp.call("Target.activateTarget", {"targetId": tid})
    except RuntimeError:
        pass
    _apply_window_state(cdp, (sess_snapshot or {}).get("windowId"))
    _log(logging.INFO, sid, "tabs.new", f"tab={tid} url={url}")
    return _ok(sid, sess_snapshot or {}, url, target_id=tid)


def op_tabs_close(sid: str, ref: str) -> int:
    cdp = ensure_chrome()
    closed_tid: Optional[str] = None
    new_active: Optional[str] = None
    final_active: Optional[str] = None
    with _Lock(LOCK_FILE):
        state = load_state()
        sess = state["sessions"].get(sid)
        if not sess or not _validate_session(cdp, sess):
            print(f"bua: no window for session {sid}", file=sys.stderr)
            return 1
        live = _targets_in_window(cdp, sess["windowId"])
        _sync_tabs_order(sess, live)
        try:
            tid = _resolve_tab_ref(sess, ref)
        except ValueError as e:
            print(f"bua: {e}", file=sys.stderr)
            return 2
        if tid not in {t["targetId"] for t in live}:
            print(
                f"bua: tab {ref} not live in session window "
                f"(run `bua tabs list --session {sid}`)",
                file=sys.stderr,
            )
            return 3
        try:
            cdp.call("Target.closeTarget", {"targetId": tid})
            closed_tid = tid
        except RuntimeError as e:
            _log(logging.ERROR, sid, "tabs.close", f"{e}")
            print(f"bua: close failed: {e}", file=sys.stderr)
            return 1
        # Re-read live set after close, reconcile tabsOrder, then pick a new
        # active tab if we just closed the active one.
        live_after = _targets_in_window(cdp, sess["windowId"])
        _sync_tabs_order(sess, live_after)
        if sess.get("activeTargetId") == tid:
            if live_after:
                new_active = _pick_fallback_target(live_after)
                sess["activeTargetId"] = new_active
            else:
                sess["activeTargetId"] = None
        _touch(sess)
        save_state(state)
        final_active = sess.get("activeTargetId")
    if new_active:
        try:
            cdp.call("Target.activateTarget", {"targetId": new_active})
        except RuntimeError:
            pass
    # Re-load sess under no lock is fine: windowId is invariant post-close
    # for this path. Best-effort only; errors swallowed.
    try:
        st2 = load_state()
        s2 = st2["sessions"].get(sid) or {}
        _apply_window_state(cdp, s2.get("windowId"))
    except Exception:
        pass
    _log(logging.INFO, sid, "tabs.close",
         f"closed={closed_tid} newActive={new_active}")
    print(json.dumps({
        "ok": True, "sid": sid,
        "closedTargetId": closed_tid,
        "activeTargetId": final_active,
    }))
    return 0


def op_tabs_switch(sid: str, ref: str) -> int:
    cdp = ensure_chrome()
    previous_tid: Optional[str] = None
    resolved_tid: Optional[str] = None
    wid: Any = None
    with _Lock(LOCK_FILE):
        state = load_state()
        sess = state["sessions"].get(sid)
        if not sess or not _validate_session(cdp, sess):
            print(f"bua: no window for session {sid}", file=sys.stderr)
            return 1
        wid = sess["windowId"]
        live = _targets_in_window(cdp, wid)
        _sync_tabs_order(sess, live)
        try:
            tid = _resolve_tab_ref(sess, ref)
        except ValueError as e:
            print(f"bua: {e}", file=sys.stderr)
            return 2
        live_ids = {t["targetId"] for t in live}
        if tid not in live_ids:
            print(
                f"bua: tab {ref} is not live in this session window "
                f"(run `bua tabs list --session {sid}`)",
                file=sys.stderr,
            )
            return 3
        previous_tid = sess.get("activeTargetId")
        sess["activeTargetId"] = tid
        resolved_tid = tid
        _touch(sess)
        save_state(state)
    try:
        cdp.call("Target.activateTarget", {"targetId": resolved_tid})
    except RuntimeError as e:
        _log(logging.WARNING, sid, "tabs.switch", f"CDP failed: {e}")
    _apply_window_state(cdp, wid)
    _log(logging.INFO, sid, "tabs.switch",
         f"prev={previous_tid} new={resolved_tid} ref={ref}")
    print(json.dumps({
        "ok": True,
        "sid": sid,
        "tabRef": ref,
        "previousTargetId": previous_tid,
        "activeTargetId": resolved_tid,
    }))
    return 0


def op_tabs(sid: str, sub: str, rest: List[str],
            url: Optional[str]) -> int:
    if sub == "list":
        return op_tabs_list(sid)
    if sub == "new":
        u = url
        if u is None and rest:
            u = rest[0]
        return op_tabs_new(sid, u or "about:blank")
    if sub == "close":
        if not rest:
            print("bua: tabs close requires a tab ref (T<N> or targetId)",
                  file=sys.stderr)
            return 2
        return op_tabs_close(sid, rest[0])
    if sub == "switch":
        if not rest:
            print("bua: tabs switch requires a tab ref (T<N> or targetId)",
                  file=sys.stderr)
            return 2
        return op_tabs_switch(sid, rest[0])
    print(f"bua: unknown tabs subcommand '{sub}' (list|new|close|switch)",
          file=sys.stderr)
    return 2


def op_gc(idle: str = "24h", cache_max: str = "2G",
         dry_run: bool = False) -> int:
    """Garbage collect: dead windows + idle sessions.

    Note: browser cache cleanup is intentionally disabled.
    `cache_max` is kept only for CLI backward compatibility.
    """
    cdp = ensure_chrome()
    idle_sec = _parse_duration(idle)
    now = int(time.time())
    result: Dict[str, Any] = {
        "ts": now,
        "removed_dead": [],
        "closed_idle": [],
        "purged_cache_bytes": 0,
        "cache_gc_enabled": False,
        "cache_max_ignored": cache_max,
        "kept": 0,
        "errors": [],
        "dry_run": dry_run,
    }

    with _Lock(LOCK_FILE):
        state = load_state()

        # (1) dead windows
        result["removed_dead"] = _sweep_dead(cdp, state)

        # (2) idle sessions
        for sid in list(state["sessions"].keys()):
            sess = state["sessions"][sid]
            last = int(sess.get("lastUsedAt") or sess.get("createdAt") or now)
            if now - last <= idle_sec:
                continue
            wid = sess.get("windowId")
            try:
                if not dry_run and wid is not None:
                    _close_window_tabs(cdp, wid)
                state["sessions"].pop(sid, None)
                result["closed_idle"].append(sid)
            except Exception as e:
                result["errors"].append({"sid": sid, "err": str(e)})

        result["kept"] = len(state["sessions"])
        if not dry_run:
            save_state(state)

    _log(logging.INFO, "-", "gc",
         f"dead={len(result['removed_dead'])} "
         f"idle={len(result['closed_idle'])} "
         f"purged={result['purged_cache_bytes']} "
         f"kept={result['kept']} dry={dry_run}")
    print(json.dumps(result))
    return 0


