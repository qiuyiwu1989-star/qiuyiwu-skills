def _attach(cdp: CDP, target_id: str) -> str:
    """Attach to a target and return a sessionId for per-target CDP calls."""
    res = cdp.call("Target.attachToTarget",
                   {"targetId": target_id, "flatten": True})
    return res["sessionId"]


def _ok(sid: str, sess: Dict[str, Any], url: str,
        target_id: Optional[str] = None) -> int:
    """Print standard success JSON and return 0."""
    print(json.dumps({
        "ok": True,
        "sid": sid,
        "targetId": target_id or sess.get("activeTargetId"),
        "windowId": sess.get("windowId"),
        "url": url,
    }))
    return 0


def _pick_reusable_blank(cdp: CDP, state: Dict[str, Any]) -> Optional[Dict[str, str]]:
    """Find a blank/newtab page whose window is not bound to any sid."""
    sessions = state.get("sessions", {})
    if isinstance(sessions, list):
        used_wids = {s.get("windowId") for s in sessions}
    else:
        used_wids = {s.get("windowId") for s in sessions.values()}
    for t in cdp.call("Target.getTargets").get("targetInfos", []):
        if t.get("type") != "page":
            continue
        if not _is_blank_url(t.get("url") or ""):
            continue
        tid = t.get("targetId")
        try:
            wid = cdp.call("Browser.getWindowForTarget",
                           {"targetId": tid})["windowId"]
        except RuntimeError:
            continue
        if wid in used_wids:
            continue
        return {"targetId": tid, "windowId": wid}
    return None


