def op_doctor() -> int:
    """
    `bua doctor` — one-shot health report as JSON. Exits 0 unless state is
    unreadable. Designed for fast triage on production boxes.
    """
    report: Dict[str, Any] = {
        "bua_version": VERSION,
        "chrome_bin": CHROME_BIN,
        "cdp_endpoint": f"{CDP_HOST}:{CDP_PORT}",
        "state_dir": STATE_DIR,
        "state_file_exists": os.path.exists(STATE_FILE),
        "agent_browser_bin": AGENT_BROWSER_BIN,
        "profile_dir": PROFILE_DIR,
    }

    cdp = CDP()
    alive = cdp.ping(timeout=1.0)
    report["chrome_alive"] = alive
    if alive:
        report["chrome_fingerprint"] = _chrome_fingerprint(cdp)
        try:
            wids = sorted(_windows_with_pages(cdp))
        except Exception as e:
            wids = []
            report["live_window_ids_error"] = repr(e)
        report["live_window_ids"] = wids
    else:
        wids = []

    with _Lock(LOCK_FILE):
        state = load_state()
    state_fp = state.get(CHROME_FP_FIELD)
    report["state_chrome_fingerprint"] = state_fp
    report["state_fp_matches_runtime"] = bool(
        alive and state_fp and state_fp == report.get("chrome_fingerprint")
    )

    sessions = state.get("sessions", {}) or {}
    report["session_count"] = len(sessions)
    report["sessions"] = [
        {
            "sid": sid,
            "windowId": s.get("windowId"),
            "activeTargetId": (s.get("activeTargetId") or "")[:8],
            "tabCount": len(s.get("tabsOrder") or []),
            "lastUsedAt": s.get("lastUsedAt"),
            "windowAlive": s.get("windowId") in wids if alive else None,
        }
        for sid, s in sessions.items()
    ]

    print(json.dumps(report, indent=2, ensure_ascii=False))
    return 0


def op_forward(sid: str, cmd: str, extra: list) -> int:
    cdp = ensure_chrome()
    # Resolve the active tab inside the lock so concurrent forwards on the
    # same sid observe a consistent view of activeTargetId; exec the child
    # process outside the lock to avoid holding it for the full RTT.
    with _Lock(LOCK_FILE):
        state = load_state()
        sess = state["sessions"].get(sid)
        if not sess or not _validate_session(cdp, sess):
            _log(logging.ERROR, sid, cmd, "no live window")
            print(f"bua: no window for session {sid}; run `bua open` first",
                  file=sys.stderr)
            return 1
        try:
            tid, resolved_from = _resolve_active_target(cdp, sess)
        except RuntimeError as e:
            _log(logging.ERROR, sid, cmd, f"resolve failed: {e}")
            print(f"bua: {e}", file=sys.stderr)
            return 1
        if resolved_from == "fallback":
            _log(logging.WARNING, sid, cmd,
                 f"active tab fallback -> {tid}")
        wid = sess["windowId"]
        _touch(sess)
        save_state(state)

    # Bring the bound window to the foreground. CDP has no primitive for
    # "raise window without touching tab focus": Browser.setWindowBounds
    # with {windowState:"normal"} only un-minimizes, it does NOT restack
    # above other windows or switch OS focus. The only reliable primitive
    # that restacks is Target.activateTarget, which also sets that target
    # as the active tab. We activate the persisted activeTargetId so the
    # sid's intended tab wins focus regardless of creation order quirks.
    try:
        cdp.call("Target.activateTarget", {"targetId": tid})
    except RuntimeError as e:
        _log(logging.WARNING, sid, cmd, f"activate failed: {e}")
    _apply_window_state(cdp, wid)

    bin_path = AGENT_BROWSER_BIN
    if not bin_path:
        _log(logging.ERROR, sid, cmd, "agent-browser not on disk (set AGENT_BROWSER_BIN)")
        print(
            "bua: agent-browser not found; place ./agent-browser or ./bin/agent-browser "
            "next to this script, or set AGENT_BROWSER_BIN",
            file=sys.stderr,
        )
        return 127

    argv = [bin_path, "--cdp", str(CDP_PORT), cmd, *extra]
    env = {**os.environ}
    env.setdefault("DISPLAY", DISPLAY)
    _log(logging.INFO, sid, cmd,
         f"forward window={wid} tab={tid} argv={argv}")
    try:
        rc = subprocess.call(argv, env=env)
    except FileNotFoundError:
        _log(logging.ERROR, sid, cmd, f"binary not found: {bin_path}")
        print(f"bua: agent-browser not found: {bin_path}", file=sys.stderr)
        return 127
    _log(logging.INFO, sid, cmd, f"exit rc={rc}")
    return rc


# --------------------------------------------------------------------------- #
# CLI                                                                          #
# --------------------------------------------------------------------------- #

def main(argv: list) -> int:
    p = argparse.ArgumentParser(prog="bua", add_help=True)
    p.add_argument("--version", action="version", version=f"bua {VERSION}")
    p.add_argument("cmd")
    p.add_argument("--session", default=None)
    p.add_argument("--url", default=None)
    p.add_argument("--replace-tab", action="store_true", dest="replace_tab",
                   help="open/start: if session window exists, navigate in the "
                   "current active tab instead of opening a new tab")
    p.add_argument("--idle", default="24h",
                   help="Close sessions idle longer than this (gc only)")
    p.add_argument("--cache-max", default="2G", dest="cache_max",
                   help="Purge Chrome cache when total exceeds this (gc only)")
    p.add_argument("--dry-run", action="store_true", dest="dry_run",
                   help="gc: compute but do not mutate")
    a, rest = p.parse_known_args(argv)

    cmd = a.cmd
    sid = a.session or os.environ.get("BUA_SESSION")

    try:
        if cmd in ("open", "start"):
            if not sid:
                print("bua: --session required", file=sys.stderr); return 2
            url = a.url
            if url is None and rest:
                url = rest[0]
            return op_open(sid, url or "about:blank",
                           replace_tab=a.replace_tab)
        if cmd == "close":
            if not sid:
                print("bua: --session required", file=sys.stderr); return 2
            return op_close(sid)
        if cmd == "focus":
            if not sid:
                print("bua: --session required", file=sys.stderr); return 2
            return op_focus(sid)
        if cmd == "status":
            return op_status(sid)
        if cmd == "list":
            return op_list()
        if cmd == "doctor":
            return op_doctor()
        if cmd == "gc":
            return op_gc(a.idle, a.cache_max, a.dry_run)
        if cmd == "tabs":
            if not sid:
                print("bua: --session required for 'tabs'",
                      file=sys.stderr); return 2
            if not rest:
                print("bua: tabs requires a subcommand "
                      "(list|new|close|switch)", file=sys.stderr)
                return 2
            sub = rest[0]
            sub_rest = rest[1:]
            return op_tabs(sid, sub, sub_rest, a.url)
        if cmd in FORWARD_CMDS or cmd not in NATIVE_CMDS:
            if not sid:
                print(f"bua: --session required for '{cmd}'", file=sys.stderr)
                return 2
            extra = list(rest)
            if cmd == "goto" and a.url and a.url not in extra:
                extra = [a.url] + extra
            return op_forward(sid, cmd, extra)
        print(f"bua: unknown command '{cmd}'", file=sys.stderr)
        return 2
    except Exception as e:
        _log(logging.ERROR, sid or "-", cmd, f"unhandled: {e!r}")
        print(f"bua: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
