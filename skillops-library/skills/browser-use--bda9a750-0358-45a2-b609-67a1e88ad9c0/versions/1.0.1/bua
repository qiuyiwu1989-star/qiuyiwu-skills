def _init_logger() -> logging.Logger:
    lg = logging.getLogger("bua")
    lg.setLevel(logging.INFO)
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        h: logging.Handler = RotatingFileHandler(
            LOG_PATH, maxBytes=10 * 1024 * 1024, backupCount=5
        )
    except (PermissionError, OSError):
        h = logging.StreamHandler(sys.stderr)
    h.setFormatter(logging.Formatter(
        "%(asctime)s %(levelname)s sid=%(sid)s cmd=%(cmd)s %(message)s"
    ))
    lg.addHandler(h)
    return lg


LOG = _init_logger()


def _log(level: int, sid: str, cmd: str, msg: str) -> None:
    LOG.log(level, msg, extra={"sid": sid or "-", "cmd": cmd or "-"})


# --------------------------------------------------------------------------- #
# Minimal WebSocket client (CDP only)                                         #
# --------------------------------------------------------------------------- #

class _WS:
    def __init__(self, url: str, timeout: float = 10.0) -> None:
        assert url.startswith("ws://"), url
        hp, path = url[5:].split("/", 1)
        host, port = hp.split(":")
        self.sock = socket.create_connection((host, int(port)), timeout=timeout)
        self.sock.settimeout(timeout)
        key = base64.b64encode(os.urandom(16)).decode()
        req = (
            f"GET /{path} HTTP/1.1\r\n"
            f"Host: {hp}\r\n"
            f"Upgrade: websocket\r\n"
            f"Connection: Upgrade\r\n"
            f"Sec-WebSocket-Key: {key}\r\n"
            f"Sec-WebSocket-Version: 13\r\n\r\n"
        )
        self.sock.sendall(req.encode())
        buf = b""
        while b"\r\n\r\n" not in buf:
            chunk = self.sock.recv(4096)
            if not chunk:
                raise RuntimeError("ws handshake aborted")
            buf += chunk
        head, self._buf = buf.split(b"\r\n\r\n", 1)
        if b" 101 " not in head.split(b"\r\n", 1)[0]:
            raise RuntimeError(f"ws handshake failed: {head!r}")

    def _read_exact(self, n: int) -> bytes:
        while len(self._buf) < n:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("ws closed")
            self._buf += chunk
        out, self._buf = self._buf[:n], self._buf[n:]
        return out

    def send(self, text: str) -> None:
        data = text.encode()
        mask = os.urandom(4)
        hdr = b"\x81"
        ln = len(data)
        if ln < 126:
            hdr += bytes([0x80 | ln])
        elif ln < 65536:
            hdr += b"\xfe" + struct.pack(">H", ln)
        else:
            hdr += b"\xff" + struct.pack(">Q", ln)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
        self.sock.sendall(hdr + mask + masked)

    def recv(self) -> str:
        while True:
            b1, b2 = self._read_exact(2)
            ln = b2 & 0x7F
            if ln == 126:
                ln = struct.unpack(">H", self._read_exact(2))[0]
            elif ln == 127:
                ln = struct.unpack(">Q", self._read_exact(8))[0]
            masked = bool(b2 & 0x80)
            mask = self._read_exact(4) if masked else b""
            data = self._read_exact(ln)
            if masked:
                data = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
            op = b1 & 0x0F
            if op == 1:
                return data.decode()
            if op == 8:
                raise ConnectionError("ws closed by peer")
            # ping / pong / binary -> ignore

    def close(self) -> None:
        try:
            self.sock.sendall(b"\x88\x80" + os.urandom(4))
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass


# --------------------------------------------------------------------------- #
# CDP client                                                                  #
# --------------------------------------------------------------------------- #

class CDP:
    def __init__(self, host: str = CDP_HOST, port: int = CDP_PORT) -> None:
        self.host, self.port = host, port
        self._ws: Optional[_WS] = None
        self._id = 0

    def _http_json(self, path: str) -> Any:
        url = f"http://{self.host}:{self.port}{path}"
        with urllib.request.urlopen(url, timeout=5) as r:
            return json.loads(r.read())

    def ping(self, timeout: float = 1.5) -> bool:
        try:
            with socket.create_connection((self.host, self.port), timeout=timeout):
                return True
        except OSError:
            return False

    def connect(self) -> None:
        if self._ws is not None:
            return
        ver = self._http_json("/json/version")
        self._ws = _WS(ver["webSocketDebuggerUrl"])

    def call(self, method: str, params: Optional[Dict[str, Any]] = None,
             session_id: Optional[str] = None) -> Dict[str, Any]:
        self.connect()
        assert self._ws is not None
        self._id += 1
        msg: Dict[str, Any] = {"id": self._id, "method": method,
                               "params": params or {}}
        if session_id:
            msg["sessionId"] = session_id
        self._ws.send(json.dumps(msg))
        while True:
            raw = self._ws.recv()
            data = json.loads(raw)
            if data.get("id") == self._id:
                if "error" in data:
                    raise RuntimeError(f"CDP {method} error: {data['error']}")
                return data.get("result", {})

    def close(self) -> None:
        if self._ws is not None:
            self._ws.close()
            self._ws = None


