_TAB_REF_RE = re.compile(r"^[Tt](\d+)$")
_HEX_TID_RE = re.compile(r"^[0-9A-Fa-f]{32}$")


def _is_blank_url(url: str) -> bool:
    if url in _BLANK_URLS:
        return True
    return url.startswith("chrome://new-tab-page")


# --------------------------------------------------------------------------- #
# Window state applied when bua brings a session window to the foreground
# or spawns a new one. Accepts the Chrome `windowState` values:
#   - "maximized" (default): fill the work area, keep tab bar / title bar
#   - "fullscreen": F11-style, hides tab bar and title bar
#   - "normal":    legacy behaviour, just un-minimize
WINDOW_STATE = os.environ.get("BUA_WINDOW_STATE", "maximized").strip().lower()
if WINDOW_STATE not in ("maximized", "fullscreen", "normal"):
    WINDOW_STATE = "maximized"


def _apply_window_state(cdp: "CDP", wid: Any) -> None:
    """Force `wid` into the configured WINDOW_STATE. Best-effort: CDP errors
    (window already gone / unsupported state) are swallowed — callers are
    tolerant to focus failures.

    Chrome rejects setting non-normal states directly from a non-normal
    source; the documented safe path is to always go through `normal` first
    when switching between maximized <-> fullscreen. For our bua usage we
    only ever stamp one terminal state, so a single call suffices.
    """
    if wid is None:
        return
    try:
        cdp.call("Browser.setWindowBounds",
                 {"windowId": wid,
                  "bounds": {"windowState": WINDOW_STATE}})
    except RuntimeError:
        pass


